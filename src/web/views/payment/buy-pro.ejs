<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/static/css/professional.css">
    <style>
        .packages-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .package-card {
            background-color: var(--bg-secondary);
            border: 2px solid var(--border);
            border-radius: 12px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .package-card:hover {
            border-color: var(--accent);
            transform: translateY(-5px);
        }
        .package-name {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 15px;
        }
        .package-price {
            font-size: 36px;
            font-weight: 800;
            color: var(--accent);
            margin: 20px 0;
        }
        .package-credits {
            font-size: 16px;
            color: var(--text-secondary);
            margin-bottom: 20px;
        }
        .package-features {
            list-style: none;
            text-align: left;
            margin: 20px 0;
        }
        .package-features li {
            padding: 8px 0;
            color: var(--text-secondary);
            font-size: 14px;
        }
        .package-features li:before {
            content: "✓";
            color: var(--success);
            font-weight: bold;
            margin-right: 10px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-title">ARYZZ PANEL</div>
            <div class="brand-subtitle">DDoS Testing Platform</div>
        </div>
        
        <nav class="sidebar-nav">
            <div class="nav-item">
                <a href="/dashboard" class="nav-link">
                    <span class="nav-icon">
                        <svg fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
                    </span>
                    Dashboard
                </a>
            </div>
            <div class="nav-item">
                <a href="/attack" class="nav-link">
                    <span class="nav-icon">
                        <svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>
                    </span>
                    Attack Control
                </a>
            </div>
            <div class="nav-item">
                <a href="/payment/buy" class="nav-link active">
                    <span class="nav-icon">
                        <svg fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/></svg>
                    </span>
                    Buy Credits
                </a>
            </div>
            <div class="nav-item">
                <a href="/payment/history" class="nav-link">
                    <span class="nav-icon">
                        <svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
                    </span>
                    History
                </a>
            </div>
        </nav>
    </div>
    
    <div class="main-content">
        <header class="header">
            <h1 class="header-title">Buy Credits</h1>
            <div class="header-actions">
                <button id="themeToggle" class="theme-toggle"></button>
                <div class="user-menu">
                    <div class="user-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
                    <div class="user-info">
                        <div class="user-name"><%= user.username %></div>
                        <div class="user-role"><%= user.role %></div>
                    </div>
                </div>
            </div>
        </header>
        
        <div class="container">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Choose Your Package</h2>
                </div>
                <div class="card-body">
                    <div class="packages-grid">
                        <% Object.keys(packages).forEach(key => { const pkg = packages[key]; %>
                            <div class="package-card" onclick="selectPackage('<%= key %>', '<%= pkg.name %>', <%= pkg.price %>, <%= pkg.credits %>)">
                                <div class="package-name"><%= pkg.name %></div>
                                <div class="package-price">Rp <%= pkg.price.toLocaleString() %></div>
                                <div class="package-credits"><%= pkg.credits %> Credits</div>
                                <ul class="package-features">
                                    <% pkg.features.forEach(feature => { %>
                                        <li><%= feature %></li>
                                    <% }) %>
                                </ul>
                                <button class="btn btn-primary" style="width: 100%;">Select Package</button>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Payment Modal -->
    <div id="paymentModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Payment Details</h2>
                <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div style="background-color: var(--bg-tertiary); padding: 20px; border-radius: 8px; margin-bottom: 20px;">
                    <h3 style="margin-bottom: 10px;">Package: <span id="selectedPackage"></span></h3>
                    <p style="color: var(--text-secondary);">Price: <strong style="color: var(--accent);">Rp <span id="selectedPrice"></span></strong></p>
                    <p style="color: var(--text-secondary);">Credits: <strong><span id="selectedCredits"></span></strong></p>
                </div>
                
                <form id="paymentForm" enctype="multipart/form-data">
                    <input type="hidden" id="packageType" name="package">
                    
                    <div class="form-group">
                        <label class="form-label">Payment Method</label>
                        <select id="paymentMethod" name="paymentMethod" class="form-control" required onchange="updatePaymentInfo()">
                            <option value="dana">DANA</option>
                            <option value="qris">QRIS (All E-Wallets)</option>
                        </select>
                    </div>
                    
                    <div id="paymentInstructions" style="background-color: var(--bg-tertiary); padding: 20px; border-radius: 8px; margin-bottom: 20px;">
                        <h4 style="margin-bottom: 15px;">DANA Payment</h4>
                        <p style="color: var(--text-secondary); margin-bottom: 8px;">Number: <strong><%= settings.dana_number || '089998497763' %></strong></p>
                        <p style="color: var(--text-secondary); margin-bottom: 8px;">Name: <strong><%= settings.dana_name || 'Arya' %></strong></p>
                        <p style="color: var(--text-muted); font-size: 13px; margin-top: 15px;">Transfer to the number above, then upload payment proof below.</p>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Upload Payment Proof</label>
                        <input type="file" name="proof" class="form-control" accept="image/jpeg,image/png" required>
                    </div>
                    
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Submit Payment</button>
                </form>
            </div>
        </div>
    </div>
    
    <script src="/static/js/theme.js"></script>
    <script>
        let selectedPackageKey = '';
        
        function selectPackage(key, name, price, credits) {
            selectedPackageKey = key;
            document.getElementById('selectedPackage').textContent = name;
            document.getElementById('selectedPrice').textContent = price.toLocaleString();
            document.getElementById('selectedCredits').textContent = credits;
            document.getElementById('packageType').value = key;
            document.getElementById('paymentModal').classList.add('active');
        }
        
        function closeModal() {
            document.getElementById('paymentModal').classList.remove('active');
        }
        
        function updatePaymentInfo() {
            const method = document.getElementById('paymentMethod').value;
            const instructions = document.getElementById('paymentInstructions');
            
            if (method === 'dana') {
                instructions.innerHTML = `
                    <h4 style="margin-bottom: 15px;">DANA Payment</h4>
                    <p style="color: var(--text-secondary); margin-bottom: 8px;">Number: <strong><%= settings.dana_number || '089998497763' %></strong></p>
                    <p style="color: var(--text-secondary); margin-bottom: 8px;">Name: <strong><%= settings.dana_name || 'Arya' %></strong></p>
                    <p style="color: var(--text-muted); font-size: 13px; margin-top: 15px;">Transfer to the number above, then upload payment proof below.</p>
                `;
            } else {
                instructions.innerHTML = `
                    <h4 style="margin-bottom: 15px;">QRIS Payment</h4>
                    <p style="color: var(--text-secondary); margin-bottom: 15px;">Scan the QR code with any e-wallet app</p>
                    <img src="<%= settings.qris_image || '/uploads/qris.png' %>" style="max-width: 200px; border-radius: 8px;">
                    <p style="color: var(--text-muted); font-size: 13px; margin-top: 15px;">After payment, upload proof below.</p>
                `;
            }
        }
        
        document.getElementById('paymentForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            
            try {
                const response = await fetch('/payment/submit', {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                
                if (data.success) {
                    alert('Payment submitted successfully! Please wait for admin approval.');
                    window.location.href = '/payment/history';
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (err) {
                alert('Failed to submit payment: ' + err.message);
            }
        });
        
        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.classList.remove('active');
            }
        }
    </script>
</body>
</html>
