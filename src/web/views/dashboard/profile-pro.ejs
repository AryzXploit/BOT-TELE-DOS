<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/static/css/professional.css">
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-title">ARYZZ PANEL</div>
            <div class="brand-subtitle">DDoS Testing Platform</div>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-item"><a href="/dashboard" class="nav-link"><span class="nav-icon"><svg fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg></span>Dashboard</a></div>
            <div class="nav-item"><a href="/attack" class="nav-link"><span class="nav-icon"><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg></span>Attack Control</a></div>
            <div class="nav-item"><a href="/payment/buy" class="nav-link"><span class="nav-icon"><svg fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/></svg></span>Buy Credits</a></div>
            <div class="nav-item"><a href="/dashboard/history" class="nav-link"><span class="nav-icon"><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg></span>History</a></div>
            <div class="nav-item"><a href="/dashboard/profile" class="nav-link active"><span class="nav-icon"><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg></span>Profile</a></div>
        </nav>
    </div>
    
    <div class="main-content">
        <header class="header">
            <h1 class="header-title">Profile</h1>
            <div class="header-actions">
                <button id="themeToggle" class="theme-toggle"></button>
                <div class="user-menu">
                    <div class="user-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
                    <div class="user-info"><div class="user-name"><%= user.username %></div><div class="user-role"><%= user.role %></div></div>
                </div>
            </div>
        </header>
        
        <div class="container">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Account Information</h2>
                </div>
                <div class="card-body">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                        <div style="padding: 15px; background: var(--bg-tertiary); border-radius: 8px;">
                            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 5px;">Username</div>
                            <div style="font-weight: 600; color: var(--text-primary);"><%= user.username %></div>
                        </div>
                        <div style="padding: 15px; background: var(--bg-tertiary); border-radius: 8px;">
                            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 5px;">Email</div>
                            <div style="font-weight: 600; color: var(--text-primary);"><%= user.email %></div>
                        </div>
                        <div style="padding: 15px; background: var(--bg-tertiary); border-radius: 8px;">
                            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 5px;">Role</div>
                            <div><span class="badge badge-<%= user.role === 'admin' ? 'danger' : 'primary' %>"><%= user.role %></span></div>
                        </div>
                        <div style="padding: 15px; background: var(--bg-tertiary); border-radius: 8px;">
                            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 5px;">Credits</div>
                            <div style="font-weight: 600; color: var(--accent); font-size: 20px;"><%= user.credits.toLocaleString() %></div>
                        </div>
                        <div style="padding: 15px; background: var(--bg-tertiary); border-radius: 8px;">
                            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 5px;">Total Attacks</div>
                            <div style="font-weight: 600; color: var(--text-primary);"><%= user.total_attacks %></div>
                        </div>
                        <div style="padding: 15px; background: var(--bg-tertiary); border-radius: 8px;">
                            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 5px;">Package</div>
                            <div style="font-weight: 600; color: var(--text-primary);"><%= user.package_type || 'Free' %></div>
                        </div>
                        <div style="padding: 15px; background: var(--bg-tertiary); border-radius: 8px;">
                            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 5px;">Member Since</div>
                            <div style="font-weight: 600; color: var(--text-primary);"><%= new Date(user.created_at).toLocaleDateString() %></div>
                        </div>
                        <div style="padding: 15px; background: var(--bg-tertiary); border-radius: 8px;">
                            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 5px;">Last Login</div>
                            <div style="font-weight: 600; color: var(--text-primary);"><%= user.last_login ? new Date(user.last_login).toLocaleString() : 'Never' %></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Credit History</h2>
                </div>
                <div class="card-body">
                    <% if (creditHistory && creditHistory.length > 0) { %>
                        <div class="table-container">
                            <table>
                                <thead><tr><th>Type</th><th>Amount</th><th>Description</th><th>Balance</th><th>Date</th></tr></thead>
                                <tbody>
                                    <% creditHistory.forEach(history => { %>
                                        <tr>
                                            <td><span class="badge badge-primary"><%= history.type %></span></td>
                                            <td style="font-weight: 600; color: <%= history.amount > 0 ? 'var(--success)' : 'var(--danger)' %>"><%= history.amount > 0 ? '+' : '' %><%= history.amount %></td>
                                            <td><%= history.description %></td>
                                            <td><%= history.balance_after %></td>
                                            <td><%= new Date(history.created_at).toLocaleString() %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <p style="color: var(--text-muted); text-align: center; padding: 40px;">No credit history yet.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    
    <script src="/static/js/theme.js"></script>
</body>
</html>
